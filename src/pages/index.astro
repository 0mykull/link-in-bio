---
import BaseLayout from "../layouts/BaseLayout.astro";
import TelemetryBar from "../components/TelemetryBar";
import PlayButton from "../components/PlayButton";
import AsciiArt from "../components/AsciiArt";
import { PROFILE, SOCIALS } from "../data/links";
---

<BaseLayout title={`${PROFILE.handle} — index`} description={PROFILE.bio}>
  <!-- Top Index Header -->
  <header class="mb-8 space-y-4">
    <div class="flex items-center justify-between gap-2">
      <h1 class="text-base font-medium tracking-tight lowercase">
        {PROFILE.handle}
        <span class="font-mono-tech ml-1.5 text-xs font-normal text-[var(--muted)]">
          ({PROFILE.alias})
        </span>
      </h1>
      <PlayButton client:load />
    </div>

    <TelemetryBar client:load />
  </header>

  <!-- Bio -->
  <section class="mb-10 space-y-3 text-[15px] leading-relaxed text-[#222222] lowercase">
    <p>{PROFILE.bio}</p>
    <p class="font-mono-tech text-xs text-[var(--muted)]">
      now: {PROFILE.status}
    </p>
  </section>

  <AsciiArt client:load />

  <!-- Socials -->
  <section class="mb-10">
    <div class="mb-3 border-b border-[#111111] pb-1.5">
      <h2 class="font-mono-tech text-xs uppercase tracking-wider">
        socials
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-2">
      {SOCIALS.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between border border-[var(--border)] bg-white px-4 py-4 text-base transition-colors hover:border-[#111111]"
        >
          <span class="lowercase font-medium">{social.name}</span>
          <span class="font-mono-tech text-sm text-[var(--muted)] group-hover:text-[#111111]">
            {social.handle} ↗
          </span>
        </a>
      ))}
    </div>
  </section>

  <footer class="font-mono-tech flex flex-wrap items-center justify-between gap-2 border-t border-[var(--border)] pt-4 text-[11px] text-[var(--muted)]">
    <span>© mykull, {new Date().getFullYear()}</span>
    <span>【=◈︿◈=】</span>
  </footer>
</BaseLayout>
